# ── Server ─────────────────────────────────────────────
PORT=3001
# Bind address. Render/clouds require 0.0.0.0 (default sudah ini).
HOST=0.0.0.0

# WAJIB di production: token panitia untuk membuat/mengubah/menghapus acara.
# Kirim sebagai header `x-admin-token`. Bisa beberapa token dipisah koma.
# Buat acak: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# URL publik API (ex: https://satu-album-api.onrender.com).
# Dibutuhkan supaya URL foto lokal menjadi absolut ketika SPA di domain lain.
PUBLIC_BASE_URL=

# Domain client yang boleh call API (ex: https://satu-album.vercel.app).
# Kosong = izinkan semua (hanya untuk dev lokal). Pisahkan dengan koma.
ALLOWED_ORIGIN=

# Folder penyimpanan JSON & upload lokal (relatif terhadap server/ atau path absolut)
DATA_DIR=data
UPLOAD_DIR=uploads

# ── Batas / pengaman ───────────────────────────────────
# Ukuran maksimum 1 foto (MB). Klien sudah mengecilkan ke 2048px sebelum kirim.
MAX_UPLOAD_MB=8
# Batas jumlah foto per acara (proteksi kuota Drive 15 GB).
MAX_PHOTOS_PER_EVENT=800
# Rate limit per IP (per jam).
RATE_CREATE_PER_HOUR=10
RATE_UPLOAD_PER_HOUR=300
# Jendela tombol Undo untuk tamu (ms).
SA_UNDO_WINDOW_MS=120000
# Umur cache daftar acara/foto (ms) — menjaga kuota Drive API.
SA_CACHE_TTL_MS=10000
# Jeda penulisan ulang metadata event.json (ms).
SA_META_FLUSH_MS=3000

# ── Google Drive (WAJIB untuk produksi) ────────────────
# Tanpa kredensial ini, foto disimpan ke server/uploads/ dan HILANG saat Render restart.
# Mode utama: OAuth2 akun Google PRIBADI — foto masuk kuota Drive akun Anda sendiri.
# (Service account punya kuota storage 0 byte sehingga upload selalu gagal.)
#
# Langkah: 1) aktifkan Drive API di Google Cloud Console,
#          2) buat OAuth client ID bertipe "Desktop app",
#          3) isi dua nilai di bawah, lalu jalankan:
#               npm run token
#             dan salin GOOGLE_REFRESH_TOKEN yang dicetak.
# Penting: OAuth consent screen harus berstatus "In production". Selama masih
# "Testing", refresh token otomatis kedaluwarsa dalam 7 hari.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Folder tujuan di Drive. Biarkan ID kosong supaya server membuat folder otomatis
# (WAJIB dibuat oleh app karena scope drive.file hanya melihat file buatan app).
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Satu-Album
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Ukuran gambar yang diminta dari Drive (px, sisi terpanjang).
GOOGLE_DRIVE_IMAGE_WIDTH=1600
GOOGLE_DRIVE_THUMB_WIDTH=400

# ── Legacy: service account (kuota storage 0 byte, hanya cocok untuk Shared Drive) ──
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
